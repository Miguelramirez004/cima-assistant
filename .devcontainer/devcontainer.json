{
  "name": "CIMA Assistant (Next.js + FastAPI)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "docs/MIGRATION_PLAN.md"]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "updateContentCommand": "python -m venv .venv && .venv/bin/pip install -r requirements-dev.txt && npm install",
  "postAttachCommand": {
    "app": "npm run dev"
  },
  "portsAttributes": {
    "3000": { "label": "Web (Next.js)", "onAutoForward": "openPreview" },
    "8000": { "label": "API (FastAPI)" }
  },
  "forwardPorts": [3000, 8000]
}
