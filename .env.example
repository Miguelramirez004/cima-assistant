# Copy to .env (Python API) / .env.local (Next.js). Never commit real secrets.

# OpenAI (API only)
OPENAI_API_KEY=

# Supabase project cima-assistant (Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=https://dmdboqstotxpoidodrow.supabase.co
# Publishable key: safe in the browser (RLS protects the data).
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only, never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Public URL of the app, used in invitation links (defaults to the request origin)
APP_URL=
# Per-user limit of OpenAI-backed requests per minute
USER_REQUESTS_PER_MINUTE=10

# Local UI work without Supabase/OpenAI: sample data, no login (ignored in production builds)
# NEXT_PUBLIC_PREVIEW_MODE=1
